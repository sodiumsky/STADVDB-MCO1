# Copy to .env for local use. On a host, set these in its environment-variable settings instead.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-password
DB_NAME=green_taxi_dw
# Set to true when the database is a hosted service that requires an encrypted connection.
DB_SSL=false

# Port for the Express API. Hosts such as Render and Railway set this for you.
PORT=3001
